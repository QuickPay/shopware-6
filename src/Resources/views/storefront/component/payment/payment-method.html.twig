{% sw_extends '@Storefront/storefront/component/payment/payment-method.html.twig' %}
    {% block component_payment_method_field %}
        {% set userAgent = app.request.headers.get('user-agent') %}
        {% set hide = false %}

        {% if 'Google' in payment.handlerIdentifier %}
            {# CriOs is chrome on iOS devices
                https://chromium.googlesource.com/chromium/src.git/+/HEAD/docs/ios/user_agent.md
            #}
            {% if (('Android' not in userAgent) and ('Chrome' not in userAgent) and ('CriOS' not in userAgent)) %}
                {% set hide = true %}
            {% endif %}
        {% endif %}

        {% if 'Apple' in payment.handlerIdentifier %}
            {% if (('Mac' not in userAgent) and ('iPhone' not in userAgent) and ('iPad' not in userAgent)) %}
                {% set hide = true %}
            {% endif %}
        {% endif %}

        <div class="payment-form-group form-group {% if hide %}d-none{% endif %}">
            {% block component_payment_method_control %}
                {{ parent() }}
            {% endblock %}
        </div>
    {% endblock %}
