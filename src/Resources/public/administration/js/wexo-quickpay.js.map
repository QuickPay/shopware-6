module.exports = "{% block quickpay_order_payment_details %}\n    <sw-card v-if=\"orderId\"\n             :orderId=\"orderId\"\n             :title=\"'Payment Details'\"\n             :isLoading=\"isLoading\"\n             :isEditing=\"isEditing\"\n             class=\"quickpay-order-payment-details\">\n        {% block quickpay_order_payment_details_payment_data_title %}\n            <strong>QuickPay | Payment solution</strong><br><br>\n        {% endblock %}\n        {% block quickpay_order_payment_details_payment_data %}\n            <sw-data-grid v-if=\"quickpayResponse\"\n                          :dataSource=\"dataSource\"\n                          :columns=\"orderColumns\"\n                          :showActions=\"false\"\n                          :showSelection=\"false\"\n                          :showHeader=\"false\">\n            </sw-data-grid><br>\n            <sw-field\n                type=\"number\"\n                :label=\"$t('quickpay.label.capture')\"\n                v-model=\"amount\"\n                min=\"0\"\n                :max=\"available\"\n                input-change=\"updateAmount()\">\n            </sw-field>\n            <sw-button\n                @click=\"capture()\"\n                size=\"small\">\n                {{ $tc('quickpay.label.capture') }}\n            </sw-button>\n        {% endblock %}\n    </sw-card>\n{% endblock %}\n";