<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Wexo\Quickpay\Core\Checkout\Cart\SalesChannel\CartOrderRouteDecorator"
                 decorates="Shopware\Core\Checkout\Cart\SalesChannel\CartOrderRoute">
            <argument type="service" id="Wexo\Quickpay\Core\Checkout\Cart\SalesChannel\CartOrderRouteDecorator.inner" />
            <argument type="service" id="Shopware\Core\Checkout\Cart\CartCalculator"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="order_customer.repository"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\Order\OrderPersister"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\CartPersister"/>
            <argument type="service" id="event_dispatcher"/>
            <argument type="service" id="order_transaction.repository"/>
            <argument type="service" id="Shopware\Core\Framework\Plugin\Util\PluginIdProvider"/>
        </service>

        <service id="Wexo\Quickpay\Service\QuickpayPayment">
            <argument type="service" id="order_transaction.repository" />
            <argument type="service" id="Wexo\Quickpay\Service\PaymentQuickpayService" />
            <argument type="service" id="Wexo\Quickpay\Service\SubscriptionQuickpayService" />
            <argument type="service" id="Wexo\Quickpay\Service\ShopwareStateService"/>
            <tag name="shopware.payment.method" />
        </service>

        <service id="Wexo\Quickpay\Service\ShopwareStateService">
            <argument type="service" id="Shopware\Core\Checkout\Order\Aggregate\OrderTransaction\OrderTransactionStateHandler"/>
            <argument type="service" id="Shopware\Core\System\StateMachine\StateMachineRegistry"/>
        </service>

        <service id="Wexo\Quickpay\Service\QuickpayService"
                 class="Wexo\Quickpay\Service\QuickpayService">
            <argument type="service" id="order_transaction.repository"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="log_entry.repository"/>
            <argument type="service" id="language.repository"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="Shopware\Core\Checkout\Order\Aggregate\OrderTransaction\OrderTransactionStateHandler"/>
            <argument type="service" id="Shopware\Core\System\StateMachine\StateMachineRegistry"/>
        </service>

        <service id="Wexo\Quickpay\Service\PaymentQuickpayService"
                 class="Wexo\Quickpay\Service\PaymentQuickpayService"
                 parent="Wexo\Quickpay\Service\QuickpayService" />

        <service id="Wexo\Quickpay\Service\SubscriptionQuickpayService"
                 class="Wexo\Quickpay\Service\SubscriptionQuickpayService"
                 parent="Wexo\Quickpay\Service\QuickpayService" />

        <!-- Payment Method(s) -->
        <service id="Wexo\Quickpay\Service\KlarnaPayment"
                 parent="Wexo\Quickpay\Service\QuickpayPayment">
            <tag name="shopware.payment.method" />
        </service>

        <service id="Wexo\Quickpay\Service\ViabillPayment"
                 parent="Wexo\Quickpay\Service\QuickpayPayment">
            <tag name="shopware.payment.method" />
        </service>

        <service id="Wexo\Quickpay\Service\MobilepayPayment"
                 parent="Wexo\Quickpay\Service\QuickpayPayment">
            <tag name="shopware.payment.method" />
        </service>

        <service id="Wexo\Quickpay\Service\SwishPayment"
                 parent="Wexo\Quickpay\Service\QuickpayPayment">
            <tag name="shopware.payment.method" />
        </service>

        <service id="Wexo\Quickpay\Service\PaypalPayment"
                 parent="Wexo\Quickpay\Service\QuickpayPayment">
            <tag name="shopware.payment.method" />
        </service>

        <service id="Wexo\Quickpay\Service\GooglepayPayment"
                 parent="Wexo\Quickpay\Service\QuickpayPayment">
            <tag name="shopware.payment.method" />
        </service>

        <service id="Wexo\Quickpay\Service\ApplepayPayment"
                 parent="Wexo\Quickpay\Service\QuickpayPayment">
            <tag name="shopware.payment.method" />
        </service>

        <service id="Wexo\Quickpay\Service\AnydayPayment" parent="Wexo\Quickpay\Service\QuickpayPayment">
            <tag name="shopware.payment.method"/>
        </service>

        <service id="Wexo\Quickpay\Service\VippsPayment"
                 parent="Wexo\Quickpay\Service\QuickpayPayment">
            <tag name="shopware.payment.method" />
        </service>
        <!-- Payment Method(s) end -->

        <service id="Wexo\Quickpay\Subscriber\OrderDetailSubscriber" public="true">
            <argument type="service" id="order.repository"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <argument type="service" id="Wexo\Quickpay\Service\PaymentQuickpayService" />
            <argument type="service" id="Wexo\Quickpay\Service\SubscriptionQuickpayService" />
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Wexo\Quickpay\Subscriber\FinalizePaymentOrderTransactionCriteriaSubscriber"
                 class="Wexo\Quickpay\Subscriber\FinalizePaymentOrderTransactionCriteriaSubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Wexo\Quickpay\Controller\Api\QuickpayApiController">
            <argument type="service" id="Wexo\Quickpay\Service\PaymentQuickpayService"/>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="Wexo\Quickpay\Controller\QuickpayStorefrontController">
            <argument type="service" id="log_entry.repository" />
            <argument type="service" id="Shopware\Core\Checkout\Payment\PaymentProcessor" />
            <argument type="service" id="Shopware\Core\Checkout\Payment\Cart\Token\JWTFactoryV2" />
            <argument type="service" id="Shopware\Core\Checkout\Cart\CartPersister"/>
            <argument type="service" id="Symfony\Component\Routing\Generator\UrlGeneratorInterface" />
            <tag name="controller.service_arguments" />
        </service>

        <service id="Wexo\Quickpay\Controller\QuickpayRecurringController">
            <argument type="service" id="log_entry.repository" />
            <argument type="service" id="order.repository" />
            <argument type="service" id="Wexo\Quickpay\Service\QuickpayService" />
            <argument type="service" id="Wexo\Quickpay\Service\ShopwareStateService" />
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="Wexo\Quickpay\Service\RefundService">
            <argument type="service" id="order.repository"/>
            <argument type="service" id="Shopware\Core\Framework\Plugin\Util\PluginIdProvider"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="log_entry.repository"/>
        </service>

        <service id="Wexo\Quickpay\Command\RefundCommand">
            <argument type="service" id="Wexo\Quickpay\Service\RefundService"/>
            <tag name="console.command" command="wexo:quickpay:refund"/>
        </service>
    </services>
</container>
