<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Wexo\Quickpay\Core\Checkout\Cart\SalesChannel\CartOrderRouteDecorator"
                 decorates="Shopware\Core\Checkout\Cart\SalesChannel\CartOrderRoute">
            <argument type="service" id="Wexo\Quickpay\Core\Checkout\Cart\SalesChannel\CartOrderRouteDecorator.inner" />
            <argument type="service" id="Shopware\Core\Checkout\Cart\CartCalculator"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="order_customer.repository"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\Order\OrderPersister"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\CartPersister"/>
            <argument type="service" id="event_dispatcher"/>
            <argument type="service" id="order_transaction.repository"/>
            <argument type="service" id="Shopware\Core\Framework\Plugin\Util\PluginIdProvider"/>
        </service>

        <service id="Wexo\Quickpay\Service\QuickpayPayment">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <argument type="service" id="log_entry.repository" />
            <argument type="service" id="order.repository"/>
            <argument type="service" id="language.repository"/>
            <argument type="service" id="Shopware\Core\Checkout\Order\Aggregate\OrderTransaction\OrderTransactionStateHandler"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\CartPersister"/>
            <argument type="service" id="Shopware\Core\System\StateMachine\StateMachineRegistry"/>
            <tag name="shopware.payment.method.async" />
        </service>

        <service id="Wexo\Quickpay\Service\KlarnaPayment">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <argument type="service" id="log_entry.repository" />
            <argument type="service" id="order.repository"/>
            <argument type="service" id="language.repository"/>
            <argument type="service" id="Shopware\Core\Checkout\Order\Aggregate\OrderTransaction\OrderTransactionStateHandler"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\CartPersister"/>
            <argument type="service" id="Shopware\Core\System\StateMachine\StateMachineRegistry"/>
            <tag name="shopware.payment.method.async" />
        </service>

        <service id="Wexo\Quickpay\Service\ViabillPayment">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <argument type="service" id="log_entry.repository" />
            <argument type="service" id="order.repository"/>
            <argument type="service" id="language.repository"/>
            <argument type="service" id="Shopware\Core\Checkout\Order\Aggregate\OrderTransaction\OrderTransactionStateHandler"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\CartPersister"/>
            <argument type="service" id="Shopware\Core\System\StateMachine\StateMachineRegistry"/>
            <tag name="shopware.payment.method.async" />
        </service>

        <service id="Wexo\Quickpay\Service\MobilepayPayment">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <argument type="service" id="log_entry.repository" />
            <argument type="service" id="order.repository"/>
            <argument type="service" id="language.repository"/>
            <argument type="service" id="Shopware\Core\Checkout\Order\Aggregate\OrderTransaction\OrderTransactionStateHandler"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\CartPersister"/>
            <argument type="service" id="Shopware\Core\System\StateMachine\StateMachineRegistry"/>
            <tag name="shopware.payment.method.async" />
        </service>

        <service id="Wexo\Quickpay\Service\SwishPayment">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <argument type="service" id="log_entry.repository" />
            <argument type="service" id="order.repository"/>
            <argument type="service" id="language.repository"/>
            <argument type="service" id="Shopware\Core\Checkout\Order\Aggregate\OrderTransaction\OrderTransactionStateHandler"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\CartPersister"/>
            <argument type="service" id="Shopware\Core\System\StateMachine\StateMachineRegistry"/>
            <tag name="shopware.payment.method.async" />
        </service>

        <service id="Wexo\Quickpay\Subscriber\OrderDetailSubscriber" public="true">
            <argument type="service" id="order.repository"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <argument type="service" id="Wexo\Quickpay\Service\QuickpayPayment" />
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Wexo\Quickpay\Controller\Api\QuickpayApiController">
            <argument type="service" id="Wexo\Quickpay\Service\QuickpayPayment"/>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="Wexo\Quickpay\Controller\QuickpayStorefrontController">
            <argument type="service" id="log_entry.repository" />
            <argument type="service" id="Shopware\Core\Checkout\Payment\PaymentService"/>
            <argument type="service" id="Shopware\Core\Checkout\Payment\Cart\Token\JWTFactoryV2" />
            <argument type="service" id="Shopware\Core\Checkout\Cart\CartPersister"/>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="Shopware\Core\Framework\Api\EventListener\Authentication\ApiAuthenticationListener"
                 class="Wexo\Quickpay\Authentication\ApiAuthenticationListenerOverride">
            <tag name="kernel.event_subscriber"/>
            <tag name="container.hot_path"/>
            <tag name="container.hot_path"/>
            <argument type="service" id="shopware.api.resource_server"/>
            <argument type="service" id="shopware.api.authorization_server"/>
            <argument type="service" id="Shopware\Core\Framework\Api\OAuth\UserRepository"/>
            <argument type="service" id="Shopware\Core\Framework\Api\OAuth\RefreshTokenRepository"/>
            <argument type="service" id="Symfony\Bridge\PsrHttpMessage\Factory\PsrHttpFactory"/>
            <argument type="service" id="Shopware\Core\Framework\Routing\RouteScopeRegistry"/>
        </service>
    </services>
</container>
